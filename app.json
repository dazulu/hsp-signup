{
  "expo": {
    "name": "Hamburg GAA",
    "slug": "hamburg-gaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11364E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dazulu.hamburggaa",
      "newArchEnabled": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#11364E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.dazulu.hamburggaa",
      "newArchEnabled": true
    },
    "owner": "shiftyapplications",
    "plugins": ["expo-font", "expo-secure-store"],
    "web": {
      "bundler": "metro",
      "output": "spa",
      "favicon": "./assets/icon.png",
      "title": "Hamburg GAA",
      "description": "The official app of the Hamburg GAA, the Gaelic Athletic Association club in Hamburg. Stay up to date with the latest news, events, and training sessions of our club."
    },
    "extra": {
      "eas": {
        "projectId": "e3cf3c92-c4fb-4747-8d95-6687f096f3b4"
      }
    }
  }
}
