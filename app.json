{
  "expo": {
    "name": "Hamburg GAA",
    "slug": "hamburg-gaa",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11364E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dazulu.hamburggaa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#11364E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.dazulu.hamburggaa",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "owner": "shiftyapplications",
    "updates": {
      "url": "https://u.expo.dev/e3cf3c92-c4fb-4747-8d95-6687f096f3b4"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-updates",
      "expo-localization",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Hamburg GAA to save photos to your library.",
          "savePhotosPermission": "Allow Hamburg GAA to save photos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "title": "Hamburg GAA",
      "description": "The official app of the Hamburg GAA, the Gaelic Athletic Association club in Hamburg. Stay up to date with the latest news, events, and training sessions of our club."
    },
    "extra": {
      "eas": {
        "projectId": "e3cf3c92-c4fb-4747-8d95-6687f096f3b4"
      }
    }
  }
}